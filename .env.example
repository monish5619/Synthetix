# AgroSense environment template.
#
# Copy this file to ".env" and set the values for your deployment. ".env" is git-ignored.
# Commit only this template, and never commit real values.
#
# Server-side variables are read only by the Node server. Nothing prefixed VITE_ may hold
# a secret, because Vite embeds those values in the public browser bundle.

# Runtime mode: development | production | test
NODE_ENV=production

# Port the server listens on.
PORT=8787

# Path to the SQLite database file. Relative paths resolve from the project root.
DATABASE_PATH=data/agrosense.db

# Comma-separated exact origins allowed to call the API from a browser on another origin.
# Leave empty for same-origin deployment, where the UI and API share one host. Never use "*".
ALLOWED_ORIGINS=

# Enables the scripted demo endpoints (simulate, reset). Set to false for a real deployment.
DEMO_MODE=true

# Shared secret for external telemetry senders (header X-Ingest-Key). Required in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep the real value out of Git. Server-side only, never prefixed VITE_.
INGEST_API_KEY=

# Maximum write requests per client per minute.
RATE_LIMIT_PER_MINUTE=120

# Build-time only, public. Leave empty to call the API on the same origin.
# Set to an https origin to point the UI at a separate API host.
VITE_API_BASE_URL=
